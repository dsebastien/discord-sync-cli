{
  "$id": "exports-state.schema.json",
  "title": "Discord export state",
  "description": "Per-channel resume cursors for the export/sync scripts. Generated from src/lib/schema.ts - edit the zod schema, not this file.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "channels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9]{17,20}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "guildId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{17,20}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "guildName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "lastExportedAt": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastMessageId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{17,20}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastMessageTimestamp": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastThreadId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{17,20}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastThreadName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "threadCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "messageCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "threads": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[0-9]{17,20}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messageCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "lastMessageId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{17,20}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastMessageTimestamp": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastAuthor": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "type",
                "messageCount",
                "lastMessageId",
                "lastMessageTimestamp",
                "lastAuthor"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "guildId",
          "guildName",
          "directory",
          "lastExportedAt",
          "lastMessageId",
          "lastMessageTimestamp",
          "lastThreadId",
          "lastThreadName",
          "threadCount",
          "messageCount",
          "threads"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "channels"
  ],
  "additionalProperties": false
}
