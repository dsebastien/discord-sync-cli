# Dependencies & build output
/node_modules/
/dist/

# Secrets
.env

# Local sync state (personal — never commit to this public repo)
/discord-sync.json


# Every other top-level directory is exported Discord data (canvas/, bases/,
# whatever channel dirs you create) or generated renditions. Allowlist only
# the project's own directories so exports can never be committed by accident.
/*/
!/src/
!/docs/
!/scripts/
!/.github/
